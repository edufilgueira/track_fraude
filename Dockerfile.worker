FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONUTF8=1 \
    PIP_NO_CACHE_DIR=1 \
    TRACK_FRAUDE_DATA_ROOT=/app/data

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        libgl1 \
        libglib2.0-0 \
        tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

COPY core ./core
COPY src ./src
COPY jobs ./jobs
COPY infra/postgres ./infra/postgres
COPY pyproject.toml README.md ./

RUN python -m pip install --upgrade pip \
    && python -m pip install -e "./core[postgres]" \
    && python -m pip install -e ".[track]" \
    && python -m pip install "pika>=1.3.0"

# Pesos YOLO no build (ctrl-p01 com internet) — GPU node offline não baixa do GitHub
RUN mkdir -p /app/models \
    && python -c "import os; os.chdir('/app/models'); from ultralytics import YOLO; YOLO('yolov8n.pt')"

VOLUME ["/app/data"]

CMD ["python", "jobs/run_daily_pipeline.py", "--help"]
