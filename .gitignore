.venv/
server/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/

# Vídeos gerados localmente (mantém estrutura via .gitkeep)
data/raw/**/*.mp4
data/raw/**/*_meta.json
!data/raw/**/.gitkeep

# Artefatos processados (sync, tracks, pipeline_state)
data/processed/**/*
data/logs/
!data/logs/.gitkeep
!data/processed/.gitkeep

# Entregáveis finais (alertas, clips)
data/output/**/*
!data/output/.gitkeep

# Banco SQLite local
# data/track_fraude.db
# data/track_fraude.db-shm
# data/track_fraude.db-wal
*.mp4 
data/video*

# Frames salvos pelos editores ROI/zona (por câmera no painel web)
server/upload/editor_frames/**/*
!server/upload/editor_frames/.gitkeep

# Legado — frames antigos em data/ (migrados para server/upload/ no startup)
data/editor_frames/
